# test photos saved straight into the workspace root (e.g. from cheese) --
# scripts/homography.json (the actual calibration result) is still tracked.
/*.jpg
/*.jpeg
/*.png

# YOLO training artifacts -- reproducible from scripts/yolo_roboflow_dataset
# (itself re-exportable from Roboflow) or by recapturing/relabeling. Only the
# actual fine-tuned weights the pipeline loads (scripts/yolo_cube_best.pt)
# are tracked, same pattern as homography.json above.
/runs/
/yolov8n.pt
scripts/*.yolov8.zip
scripts/yolo_dataset/
scripts/yolo_roboflow_dataset/
